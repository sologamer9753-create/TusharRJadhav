# GitHub API (optional - for higher rate limits: 5000/hr vs 60/hr)
# Get token at: https://github.com/settings/tokens (classic token, no scopes needed for public repos)
VITE_GITHUB_TOKEN=

# SMTP Configuration for Contact Form
# Using nodemailer - works with Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# For Gmail: Use App Password (not regular password)
# 1. Enable 2FA on Google Account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-char password as SMTP_PASS